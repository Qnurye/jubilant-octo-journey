# CompetitionTutor Environment Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# Database Connections
# =============================================================================

# Milvus (Vector Database)
MILVUS_HOST="localhost"
MILVUS_PORT="19530"
MILVUS_USER=""                    # Optional: for authenticated connections
MILVUS_PASSWORD=""                # Optional: for authenticated connections

# Neo4j (Knowledge Graph)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"         # Required: set in docker-compose

# PostgreSQL (Application Data)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"      # Required: set in docker-compose
POSTGRES_DB="jubilant_db"

# =============================================================================
# LLM Services (Qwen3 Stack)
# =============================================================================

# LLM provider: "openai" (default, OpenAI-compatible) or "vertex" (Google Vertex AI Gemini)
LLM_PROVIDER="openai"

# Main LLM (Qwen3-32B) - used when LLM_PROVIDER="openai"
LLM_BASE_URL="http://localhost:8000/v1"
LLM_MODEL="Qwen/Qwen3-32B"
LLM_API_KEY=""                    # Optional: for API authentication

# Embedding provider: "openai" (default, OpenAI-compatible) or "vertex" (Google Vertex AI)
EMBEDDING_PROVIDER="openai"

# Embedding Service (Qwen3-Embedding-8B) - used when EMBEDDING_PROVIDER="openai"
EMBEDDING_BASE_URL="http://localhost:8001/v1"
EMBEDDING_MODEL="Qwen/Qwen3-Embedding-8B"
EMBEDDING_API_KEY=""              # Optional: for API authentication
EMBEDDING_DIMENSIONS="4096"       # Vector dimensions: 4096 (Qwen3), 768 (Vertex AI), 1024 (BGE), 1536 (OpenAI small), 3072 (OpenAI large)

# Google Cloud (required when LLM_PROVIDER="vertex" or EMBEDDING_PROVIDER="vertex")
# GCP_PROJECT_ID="your-project-id"
# GCP_REGION="us-central1"

# Reranker Service (Qwen3-Reranker-4B)
RERANKER_ENABLED="true"           # Set to "false" to disable reranking (results pass through as-is)
RERANKER_BASE_URL="http://localhost:8002/v1"
RERANKER_MODEL="Qwen/Qwen3-Reranker-4B"
RERANKER_API_KEY=""               # Optional: for API authentication
RERANKER_PROVIDER="default"       # API format: default (vLLM), jina, cohere

# =============================================================================
# RAG Pipeline Configuration
# =============================================================================

# Retrieval settings
RAG_VECTOR_TOP_K="10"             # Number of results from vector search
RAG_GRAPH_MAX_HOPS="2"            # Max depth for graph traversal
RAG_RERANK_TOP_K="5"              # Number of results after reranking

# Confidence thresholds
RAG_CONFIDENCE_THRESHOLD="0.6"    # Below this triggers uncertainty acknowledgment

# Chunking settings
RAG_CHUNK_SIZE="768"              # Target chunk size in tokens (512-1024 range)
RAG_CHUNK_OVERLAP="64"            # Overlap between chunks

# =============================================================================
# Application Settings
# =============================================================================

# Environment
NODE_ENV="development"            # development | production | test

# API Server
API_PORT="8080"
API_HOST="0.0.0.0"

# Web Server
WEB_PORT="3000"

# Concurrency limits
MAX_CONCURRENT_REQUESTS="20"      # Max concurrent RAG queries (classroom scale)
REQUEST_TIMEOUT_MS="30000"        # Request timeout in milliseconds

# =============================================================================
# Service Timeouts (ms) - lower for cloud APIs, higher for local models
# =============================================================================

# EMBEDDING_TIMEOUT="300000"       # Embedding service timeout (default: 300s)
# LLM_TIMEOUT="300000"             # LLM service timeout (default: 300s)
# RERANKER_TIMEOUT="60000"         # Reranker service timeout (default: 60s)
# STORAGE_TIMEOUT="300000"         # Storage operation timeout (default: 300s)

# =============================================================================
# Vertex AI Quick Setup (uncomment to use Google Vertex AI for LLM + Embeddings)
# =============================================================================
# Requires: gcloud auth application-default login
#
# LLM_PROVIDER="vertex"
# LLM_MODEL="google/gemini-2.5-flash"
# EMBEDDING_PROVIDER="vertex"
# EMBEDDING_MODEL="text-multilingual-embedding-002"
# EMBEDDING_DIMENSIONS="768"
# GCP_PROJECT_ID="your-project-id"
# GCP_REGION="us-central1"
# RERANKER_ENABLED="false"          # No Vertex AI reranker; disable to skip reranking
